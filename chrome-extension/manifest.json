{
  "manifest_version": 3,
  "name": "Pretty Profitz",
  "version": "3.0.2",
  "description": "Content creator earnings tracker",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://chaturbate.com/*",
    "https://*.chaturbate.com/*",
    "https://bongacams.com/*",
    "https://*.bongacams.com/*",
    "https://myfreecams.com/*",
    "https://*.myfreecams.com/*",
    "https://www.camcashgrl.com/*",
    "https://camcashgrl.com/*",
    "https://hlsdlaibnayzbfflxclj.supabase.co/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chaturbate.com/*",
        "https://*.chaturbate.com/*",
        "https://bongacams.com/*",
        "https://*.bongacams.com/*",
        "https://myfreecams.com/*",
        "https://*.myfreecams.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pretty Profitz",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
